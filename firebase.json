{
  "hosting": {
    "site": "typescript-documentacao",
    "public": "packages/typescriptlang-org/public",
    "cleanUrls": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "Web.config"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|woff|woff2|png|jpg|jpeg|svg|ico|webp)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      }
    ]
  }
}
